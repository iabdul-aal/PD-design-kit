P_opt     = 100e-6;
q_e       = 1.602e-19;

Ge_W      = 5e-6;
Ge_L      = 8e-6;

wg_H      = 220e-9;
slab_H    = 90e-9;
iGe_H     = 350e-9;
Npp_H     = 50e-9;
BOX_H     = 2e-6;
sub_H     = 0.5e-6;
Al_ind_H  = 300e-9;

D1 = 1.6e-6;
D2 = 2.56e-6;

ext_W          = Ge_W * 1.1;
iGe_W_bot      = Ge_W;
iGe_W_top      = Ge_W * 0.5;
Npp_W          = iGe_W_top;
Al_cath_W_bot  = Npp_W * 0.6;
Al_cath_W_top  = Npp_W * 0.8;
Al_anode_W_bot = 200e-9;
Al_anode_W_top = 500e-9;

clad_margin = 2e-6;

z_sub_bot  = -(BOX_H + sub_H);
z_BOX_bot  = -BOX_H;
z_Si_bot   = 0;
z_slab_top = slab_H;
z_ext_top  = wg_H;
z_iGe_bot  = z_ext_top;
z_iGe_top  = z_iGe_bot + iGe_H;
z_Npp_bot  = z_iGe_top - Npp_H;
z_Npp_top  = z_iGe_top;
z_cath_bot = z_Npp_bot;
z_cath_top = z_Npp_top + 200e-9;
z_ind_bot  = z_cath_top;
z_Al_top   = z_ind_bot + Al_ind_H;

y_anode_in_bot  = Ge_W/2 + D1;
y_anode_out_bot = y_anode_in_bot + Al_anode_W_bot;
y_anode_in_top  = Ge_W/2 + D1;
y_anode_out_top = y_anode_in_top + Al_anode_W_top;

y_left  = -(y_anode_out_bot + clad_margin);
y_right =  (y_anode_out_bot + clad_margin);

x_mid          = Ge_L / 2;
x_back_min_bot = Ge_L + D2;
x_back_max_bot = x_back_min_bot + Al_anode_W_bot;
x_back_min_top = Ge_L + D2;
x_back_max_top = x_back_min_top + Al_anode_W_top;
x_cath_max     = Ge_L;
x_cath_center  = Ge_L / 2;

V_num   = 51;
V_start = -2.5;
V_stop  =  0.5;

mat_file    = "ge_pd_gen_oband_ushaped.mat";
result_file = "ge_pd_charge_results_oband_ushaped.mat";

mat_Si   = "silicon";
mat_Ge   = "germanium";
mat_SiO2 = "sio2";
mat_Al   = "aluminum";

switchtolayout;
deleteall;

addmodelmaterial;
set("name", mat_Si);
set("color", [0.6; 0.6; 0.9; 1]);
addmaterialproperties("CT", "Si (Silicon)");
select("::model::materials::silicon::Si (Silicon)");
set("recombination.trap assisted.taun.constant", 1e-6);
set("recombination.trap assisted.taup.constant", 1e-6);
select("materials::silicon");
addmaterialproperties("HT", "Si (Silicon)");

addmodelmaterial;
set("name", mat_Ge);
set("color", [0.4; 0.8; 0.4; 1]);
addmaterialproperties("CT", "Ge (Germanium)");
select("::model::materials::germanium::Ge (Germanium)");
set("recombination.trap assisted.taun.constant", 1e-9);
set("recombination.trap assisted.taup.constant", 1e-9);
select("materials::germanium");
addmaterialproperties("HT", "Ge (Germanium)");

addmodelmaterial;
set("name", mat_SiO2);
set("color", [0.8; 0.9; 1.0; 1]);
addmaterialproperties("CT", "SiO2 (Glass) - Sze");
select("materials::sio2");
addmaterialproperties("HT", "SiO2 (Glass) - Sze");

addmodelmaterial;
set("name", mat_Al);
set("color", [0.85; 0.85; 0.1; 1]);
addmaterialproperties("CT", "Al (Aluminium) - CRC");
select("materials::aluminum");
addmaterialproperties("HT", "Al (Aluminium) - CRC");

addrect;
set("name", "SiO2_clad");
set("material", mat_SiO2);
set("x min", -clad_margin);
set("x max",  x_back_max_top + clad_margin);
set("y min",  y_left  - clad_margin);
set("y max",  y_right + clad_margin);
set("z min",  z_sub_bot - clad_margin);
set("z max",  z_Al_top  + clad_margin);
set("alpha", 0.3);

addrect;
set("name", "Si_substrate");
set("material", mat_Si);
set("x min", -clad_margin);
set("x max",  x_back_max_top + clad_margin);
set("y min",  y_left  - clad_margin);
set("y max",  y_right + clad_margin);
set("z min",  z_sub_bot);
set("z max",  z_BOX_bot);

addrect;
set("name", "BOX");
set("material", mat_SiO2);
set("x min", -clad_margin);
set("x max",  x_back_max_top + clad_margin);
set("y min",  y_left  - clad_margin);
set("y max",  y_right + clad_margin);
set("z min",  z_BOX_bot);
set("z max",  z_Si_bot);

addrect;
set("name", "Si_slab");
set("material", mat_Si);
set("x min", -clad_margin);
set("x max",  x_back_max_top + clad_margin);
set("y min",  y_left  - clad_margin);
set("y max",  y_right + clad_margin);
set("z min",  z_Si_bot);
set("z max",  z_slab_top);

addrect;
set("name", "Si_ext");
set("material", mat_Si);
set("x min", 0);
set("x max", Ge_L);
set("y min", -ext_W/2);
set("y max",  ext_W/2);
set("z min",  z_slab_top);
set("z max",  z_ext_top);

addpyramid;
set("name", "iGe");
set("material", mat_Ge);
set("x", x_mid);
set("y", 0);
set("x span bottom", Ge_L);
set("x span top",    Ge_L);
set("y span bottom", iGe_W_bot);
set("y span top",    iGe_W_top);
set("z min", z_iGe_bot);
set("z max", z_iGe_top);

addrect;
set("name", "Npp_Ge");
set("material", mat_Ge);
set("x min", 0);
set("x max", Ge_L);
set("y min", -Npp_W/2);
set("y max",  Npp_W/2);
set("z min",  z_Npp_bot);
set("z max",  z_Npp_top);

addpyramid;
set("name", "Al_cath_taper");
set("material", mat_Al);
set("x", x_cath_center);
set("y", 0);
set("x span bottom", x_cath_max);
set("x span top",    x_cath_max);
set("y span bottom", Al_cath_W_bot);
set("y span top",    Al_cath_W_top);
set("z min", z_cath_bot);
set("z max", z_ind_bot);

addrect;
set("name", "Al_cath_ind");
set("material", mat_Al);
set("x min", 0);
set("x max", x_cath_max);
set("y min", -Al_cath_W_top/2);
set("y max",  Al_cath_W_top/2);
set("z min",  z_ind_bot);
set("z max",  z_Al_top);

addrect;
set("name", "Al_anode_left_taper");
set("material", mat_Al);
set("x min", 0);
set("x max", x_back_min_bot);
set("y min", -y_anode_out_bot);
set("y max", -y_anode_in_bot);
set("z min", z_Si_bot);
set("z max", z_ind_bot);

addrect;
set("name", "Al_anode_right_taper");
set("material", mat_Al);
set("x min", 0);
set("x max", x_back_min_bot);
set("y min",  y_anode_in_bot);
set("y max",  y_anode_out_bot);
set("z min",  z_Si_bot);
set("z max",  z_ind_bot);

addrect;
set("name", "Al_anode_back_taper");
set("material", mat_Al);
set("x min", x_back_min_bot);
set("x max", x_back_max_bot);
set("y min", -y_anode_out_bot);
set("y max",  y_anode_out_bot);
set("z min",  z_Si_bot);
set("z max",  z_ind_bot);

addrect;
set("name", "Al_anode_left_ind");
set("material", mat_Al);
set("x min", 0);
set("x max", x_back_min_top);
set("y min", -y_anode_out_top);
set("y max", -y_anode_in_top);
set("z min",  z_ind_bot);
set("z max",  z_Al_top);

addrect;
set("name", "Al_anode_right_ind");
set("material", mat_Al);
set("x min", 0);
set("x max", x_back_min_top);
set("y min",  y_anode_in_top);
set("y max",  y_anode_out_top);
set("z min",  z_ind_bot);
set("z max",  z_Al_top);

addrect;
set("name", "Al_anode_back_ind");
set("material", mat_Al);
set("x min", x_back_min_top);
set("x max", x_back_max_top);
set("y min", -y_anode_out_top);
set("y max",  y_anode_out_top);
set("z min",  z_ind_bot);
set("z max",  z_Al_top);

addstructuregroup;
set("name", "Al_anode_group");
select("::model::Al_anode_left_taper");  addtogroup("Al_anode_group");
select("::model::Al_anode_right_taper"); addtogroup("Al_anode_group");
select("::model::Al_anode_back_taper");  addtogroup("Al_anode_group");
select("::model::Al_anode_left_ind");    addtogroup("Al_anode_group");
select("::model::Al_anode_right_ind");   addtogroup("Al_anode_group");
select("::model::Al_anode_back_ind");    addtogroup("Al_anode_group");

addstructuregroup;
set("name", "Al_cath_group");
select("::model::Al_cath_taper"); addtogroup("Al_cath_group");
select("::model::Al_cath_ind");   addtogroup("Al_cath_group");

addstructuregroup;
set("name", "Si_ppp_group");
select("::model::Si_slab"); addtogroup("Si_ppp_group");
select("::model::Si_ext");  addtogroup("Si_ppp_group");

select("simulation region");
set("dimension", "2D X-Normal");
set("x", x_mid);
set("y", 0);
set("y span", y_right - y_left + 2*clad_margin);
set("z min",  z_Si_bot);
set("z max",  z_Al_top);

addchargesolver;
set("name", "CHARGE");
set("solver mode", "steady state");
set("simulation temperature", 300);
set("norm length", Ge_L);
set("global iteration limit", 150);
set("solver type", "newton");

adddiffusion;
set("name", "Ppp_diff");
set("dopant type", "p");
set("concentration", 1e20);
set("volume type", "solid");
set("volume solid", "Si_ppp_group");
set("x min", -clad_margin);
set("x max",  x_back_max_top + clad_margin);
set("y min",  y_left  - clad_margin);
set("y max",  y_right + clad_margin);
set("z min",  z_Si_bot);
set("z max",  z_ext_top);

adddope;
set("name", "iGe_background");
set("dopant type", "p");
set("concentration", 1e14);
set("volume type", "solid");
set("volume solid", "iGe");
set("x min", 0);
set("x max", Ge_L);
set("y min", -iGe_W_bot/2);
set("y max",  iGe_W_bot/2);
set("z min",  z_iGe_bot);
set("z max",  z_Npp_bot);

adddiffusion;
set("name", "Npp_diff");
set("dopant type", "n");
set("concentration", 1e20);
set("volume type", "solid");
set("volume solid", "Npp_Ge");
set("x min", 0);
set("x max", Ge_L);
set("y min", -Npp_W/2);
set("y max",  Npp_W/2);
set("z min",  z_Npp_bot);
set("z max",  z_Npp_top);

addchargemesh;
set("name", "mesh_Ge");
set("x min", 0);
set("x max", Ge_L);
set("y min", -Ge_W/2 - 100e-9);
set("y max",  Ge_W/2 + 100e-9);
set("z min",  z_iGe_bot);
set("z max",  z_Npp_top);
set("max edge length", 15e-9);

addchargemesh;
set("name", "mesh_Si");
set("x min", 0);
set("x max", x_back_max_top);
set("y min",  y_left);
set("y max",  y_right);
set("z min",  z_Si_bot);
set("z max",  z_slab_top);
set("max edge length", 50e-9);

addelectricalcontact;
set("name", "cathode");
set("bc mode", "steady state");
set("sweep type", "single");
set("voltage", 0);
set("force ohmic", 1);
set("surface type", "solid");
set("solid", "Al_cath_group");

addelectricalcontact;
set("name", "anode");
set("bc mode", "steady state");
set("sweep type", "range");
set("range start", V_start);
set("range stop",  V_stop);
set("range num points", V_num);
set("force ohmic", 1);
set("surface type", "solid");
set("solid", "Al_anode_group");

addsurfacerecombinationbc;
set("name", "srbc_Ge_SiO2");
set("surface type", "material:material");
set("material 1", mat_Ge);
set("material 2", mat_SiO2);
set("electron velocity", 1e4);
set("hole velocity", 1e4);

addsurfacerecombinationbc;
set("name", "srbc_Ge_Si");
set("surface type", "material:material");
set("material 1", mat_Ge);
set("material 2", mat_Si);
set("electron velocity", 1e3);
set("hole velocity", 1e3);

addsurfacerecombinationbc;
set("name", "srbc_Si_SiO2");
set("surface type", "material:material");
set("material 1", mat_Si);
set("material 2", mat_SiO2);
set("electron velocity", 1e4);
set("hole velocity", 1e4);

addsurfacerecombinationbc;
set("name", "srbc_Ge_Al");
set("surface type", "material:material");
set("material 1", mat_Ge);
set("material 2", mat_Al);
set("electron velocity", 1e5);
set("hole velocity", 1e5);

addsurfacerecombinationbc;
set("name", "srbc_Si_Al");
set("surface type", "material:material");
set("material 1", mat_Si);
set("material 2", mat_Al);
set("electron velocity", 1e5);
set("hole velocity", 1e5);

addbandstructuremonitor;
set("name", "monitor_band");
set("monitor type", 4);
set("x", x_mid);
set("y", 0);
set("z", (z_Si_bot + z_iGe_top)/2);
set("z span", z_iGe_top - z_Si_bot + 200e-9);
set("record Evac", 1);

save("ge_pd_charge_oband_ushaped.ldev");
run;

res_dk = getresult("CHARGE", "anode");
V_dk   = res_dk.V_anode;
I_dk   = res_dk.I;
In_dk  = res_dk.In;
Ip_dk  = res_dk.Ip;

diff_V = abs(V_dk - (-1));
idx1V  = 1;
for (k = 1; k <= length(V_dk); k = k + 1) {
    if (diff_V(k) < diff_V(idx1V)) { idx1V = k; }
}
Id_1V = abs(I_dk(idx1V));

T_sim      = 300;
V_stop_val = abs(V_start);

switchtolayout;

addimportgen;
set("name", "optical_gen");
set("enabled", 1);
set("scale factor", 1);
select("CHARGE::optical_gen");
importdataset(mat_file);

?"Optical generation imported from: " + mat_file;
?"I_dark @ -1V = " + num2str(Id_1V*1e9,"%.4f") + " nA";

run;

res_ill = getresult("CHARGE", "anode");
V_ill   = res_ill.V_anode;
I_ill   = res_ill.I;
In_ill  = res_ill.In;
Ip_ill  = res_ill.Ip;

diff_V_ill = abs(V_ill - (-1));
idx1V_ill  = 1;
for (k = 1; k <= length(V_ill); k = k + 1) {
    if (diff_V_ill(k) < diff_V_ill(idx1V_ill)) { idx1V_ill = k; }
}

?"DEBUG: idx1V_ill = " + num2str(idx1V_ill);
?"DEBUG: V_ill(idx1V_ill) = " + num2str(V_ill(idx1V_ill),"%.4f") + " V";
?"DEBUG: |I_ill(idx1V_ill)| = " + num2str(abs(I_ill(idx1V_ill)),"%.6e") + " A";
?"DEBUG: Id_1V             = " + num2str(Id_1V,"%.6e") + " A";

I_ph   = abs(I_ill(idx1V_ill)) - Id_1V;
R_AW   = I_ph / P_opt;
A_eff  = Ge_L * Ge_W;
D_star = R_AW * sqrt(A_eff) / sqrt(2 * q_e * Id_1V) * 1e2;

?"DEBUG: I_ph = " + num2str(I_ph,"%.6e") + " A";
?"DEBUG: R_AW = " + num2str(R_AW,"%.6f") + " A/W";

band_res = getresult("CHARGE::monitor_band", "band structure");
Ec_data  = band_res.Ec;
Ev_data  = band_res.Ev;
Efn_data = band_res.Efn;
Efp_data = band_res.Efp;
y_band   = band_res.y;
z_band   = band_res.z;
V_band   = band_res.V_anode;
Ei_data = (Ec_data + Ev_data) / 2;

res_carr  = getresult("CHARGE", "charge");
n_e       = res_carr.n;
n_h       = res_carr.p;
Jn        = res_carr.Jn;
Jp        = res_carr.Jp;
y_carr    = res_carr.y;
z_carr    = res_carr.z;

res_recmb = getresult("CHARGE", "recombination");
R_opt     = res_recmb.Ropt;
R_srh     = res_recmb.Rsrh;
y_recmb   = res_recmb.y;
z_recmb   = res_recmb.z;

res_field = getresult("CHARGE", "electrostatics");
E_field   = res_field.E;
V_pot     = res_field.V;
y_field   = res_field.y;
z_field   = res_field.z;

res_dope  = getresult("CHARGE", "doping");
NA        = res_dope.NA;
ND        = res_dope.ND;
y_dope    = res_dope.y;
z_dope    = res_dope.z;

res_mob   = getresult("CHARGE", "mobility");
mu_n      = res_mob.mun;
mu_p      = res_mob.mup;
y_mob     = res_mob.y;
z_mob     = res_mob.z;

x_carr_v  = y_carr;
z_carr_v  = z_carr;
x_recmb_v = y_recmb;
z_recmb_v = z_recmb;
x_field_v = y_field;
z_field_v = z_field;
x_dope_v  = y_dope;
z_dope_v  = z_dope;
x_mob_v   = y_mob;
z_mob_v   = z_mob;

?"Running SSAC analysis...";
switchtolayout;
select("CHARGE");
set("solver mode", "ssac");
set("frequency spacing", "logarithmic");
set("minimum frequency", 1e6);
set("maximum frequency", 200e9);
set("number of points", 100);
set("perturbation amplitude", 1e-3);
run;

res_ssac  = getresult("CHARGE", "anode");
f_ssac    = res_ssac.f;
I_ac      = res_ssac.I;
I_ac_mag  = abs(I_ac);
I_ac_phase = angle(I_ac) * 180 / pi;
?"SSAC complete: " + num2str(length(f_ssac)) + " frequency points";

switchtolayout;
select("CHARGE");
set("solver mode", "steady state");

matlabsave(result_file, V_dk, I_dk, In_dk, Ip_dk, V_ill, I_ill, In_ill, Ip_ill, Id_1V, I_ph, R_AW, A_eff, D_star, P_opt, Ge_L, Ge_W, iGe_H, wg_H, slab_H, V_start, V_stop_val, T_sim, idx1V, idx1V_ill, x_carr_v, z_carr_v, x_recmb_v, z_recmb_v, x_field_v, z_field_v, x_dope_v, z_dope_v, x_mob_v, z_mob_v, y_band, z_band, V_band, Ec_data, Ev_data, Efn_data, Efp_data, Ei_data, n_e, n_h, Jn, Jp, R_opt, R_srh, E_field, V_pot, NA, ND, mu_n, mu_p, f_ssac, I_ac_mag, I_ac_phase);

?"Dark current @ -1 V : " + num2str(Id_1V*1e9,"%.4f") + " nA";
?"Photocurrent @ -1 V : " + num2str(I_ph*1e6,"%.4f") + " uA";
?"Responsivity  @ -1 V : " + num2str(R_AW,"%.4f") + " A/W";
?"D*            : " + num2str(D_star,"%.3e") + " cm.Hz^0.5/W";
?"Results saved to : " + result_file;