
switchtolayout;
deleteall;

q_e   = 1.602e-19;
P_opt = 100e-6;

addmodelmaterial; set("name","silicon");   addmaterialproperties("CT","Si (Silicon)");
addmodelmaterial; set("name","germanium"); addmaterialproperties("CT","Ge (Germanium)");
addmodelmaterial; set("name","sio2");      addmaterialproperties("CT","SiO2 (Glass) - Sze");
mat_Si   = "silicon";
mat_Ge   = "germanium";
mat_SiO2 = "sio2";

wg_W   = 500e-9;
wg_H   = 220e-9;
slab_H = 90e-9;
Ge_L   = 8e-6;
Ge_W   = 5e-6;
iGe_H  = 350e-9;
Npp_H  = 50e-9;
Ge_H   = iGe_H + Npp_H;
BOX_H  = 2e-6;
sub_H  = 0.5e-6;
Pp_ext = 1e-6;

z_sub_bot  = -(BOX_H + sub_H);
z_BOX_bot  = -BOX_H;
z_Si_bot   = 0;
z_slab_top = slab_H;
z_rib_top  = wg_H;
z_iGe_bot  = z_rib_top;
z_iGe_top  = z_rib_top + iGe_H;
z_Npp_top  = z_rib_top + Ge_H;
z_sim_top  = z_Npp_top;
y_left     = -(Ge_W/2 + Pp_ext);
y_right    =   Ge_W/2 + Pp_ext;

addrect; set("name","Si_substrate"); set("material",mat_Si);
set("x min",0); set("x max",Ge_L);
set("y min",y_left); set("y max",y_right);
set("z min",z_sub_bot); set("z max",z_BOX_bot);

addrect; set("name","BOX"); set("material",mat_SiO2);
set("x min",0); set("x max",Ge_L);
set("y min",y_left); set("y max",y_right);
set("z min",z_BOX_bot); set("z max",z_Si_bot);

addrect; set("name","Si_slab"); set("material",mat_Si);
set("x min",0); set("x max",Ge_L);
set("y min",y_left); set("y max",y_right);
set("z min",z_Si_bot); set("z max",z_slab_top);

addrect; set("name","Si_rib"); set("material",mat_Si);
set("x min",0); set("x max",Ge_L);
set("y min",-Ge_W/2); set("y max",Ge_W/2);
set("z min",z_slab_top); set("z max",z_rib_top);

addrect; set("name","Si_Pp_left"); set("material",mat_Si);
set("x min",0); set("x max",Ge_L);
set("y min",y_left); set("y max",-Ge_W/2);
set("z min",z_slab_top); set("z max",z_rib_top);

addrect; set("name","Si_Pp_right"); set("material",mat_Si);
set("x min",0); set("x max",Ge_L);
set("y min",Ge_W/2); set("y max",y_right);
set("z min",z_slab_top); set("z max",z_rib_top);

addrect; set("name","Si_Pp_back"); set("material",mat_Si);
set("x min",Ge_L-200e-9); set("x max",Ge_L);
set("y min",-Ge_W/2); set("y max",Ge_W/2);
set("z min",z_slab_top); set("z max",z_rib_top);

addrect; set("name","i_Ge"); set("material",mat_Ge);
set("x min",0); set("x max",Ge_L);
set("y min",-Ge_W/2); set("y max",Ge_W/2);
set("z min",z_iGe_bot); set("z max",z_iGe_top);

addrect; set("name","Npp_Ge"); set("material",mat_Ge);
set("x min",0); set("x max",Ge_L);
set("y min",-Ge_W/2); set("y max",Ge_W/2);
set("z min",z_iGe_top); set("z max",z_Npp_top);

addrect; set("name","SiO2_clad_left"); set("material",mat_SiO2);
set("x min",0); set("x max",Ge_L);
set("y min",y_left); set("y max",-Ge_W/2);
set("z min",z_rib_top); set("z max",z_sim_top);

addrect; set("name","SiO2_clad_right"); set("material",mat_SiO2);
set("x min",0); set("x max",Ge_L);
set("y min",Ge_W/2); set("y max",y_right);
set("z min",z_rib_top); set("z max",z_sim_top);

select("simulation region");
set("dimension",4);
set("x",Ge_L/2);  set("x span",Ge_L);
set("y",0);       set("y span",Ge_W + 2*Pp_ext);
set("z min",z_Si_bot);
set("z max",z_sim_top);

addchargesolver;
set("name","CHARGE");
set("solver mode","steady state");
set("simulation temperature",300);
set("global iteration limit",500);

adddope;
set("name","dope_Npp_Ge");
set("dopant type","n");
set("concentration",1e20);
set("x min",0);        set("x max",Ge_L);
set("y min",-Ge_W/2);  set("y max",Ge_W/2);
set("z min",z_iGe_top); set("z max",z_Npp_top);

adddope;
set("name","dope_Ppp_Si");
set("dopant type","p");
set("concentration",1e20);
set("x min",0);      set("x max",Ge_L);
set("y min",y_left); set("y max",y_right);
set("z min",z_Si_bot); set("z max",z_rib_top);

addchargemesh;
set("name","mesh_SCR");
set("x",Ge_L/2); set("x span",Ge_L);
set("y",0);      set("y span",Ge_W);
set("z",(z_iGe_bot+z_Npp_top)/2);
set("z span",Ge_H + 50e-9);
set("max edge length",20e-9);

addchargemesh;
set("name","mesh_junction");
set("x",Ge_L/2); set("x span",Ge_L);
set("y",0);      set("y span",Ge_W);
set("z",z_iGe_top);
set("z span",Npp_H + 60e-9);
set("max edge length",5e-9);

addchargemesh;
set("name","mesh_optical");
set("x",Ge_L/2); set("x span",Ge_L);
set("y",0);      set("y span",Ge_W);
set("z",z_iGe_bot + 100e-9);
set("z span",200e-9);
set("max edge length",20e-9);

addelectricalcontact; set("name","cathode");
set("bc mode","steady state");
set("sweep type","range");
set("range start",-4); set("range stop",0); set("range num points",9);
set("force ohmic",1);
set("surface type","solid:simulation region");
set("solid","Npp_Ge");
set("x min",0); set("x max",0);
set("y min",0); set("y max",0);
set("z min",0); set("z max",1);

addelectricalcontact; set("name","anode_side1");
set("bc mode","steady state");
set("sweep type","single"); set("voltage",0);
set("force ohmic",1);
set("surface type","solid:simulation region");
set("solid","Si_Pp_left");
set("x min",0); set("x max",0);
set("y min",1); set("y max",0);
set("z min",0); set("z max",0);

addelectricalcontact; set("name","anode_side2");
set("bc mode","steady state");
set("sweep type","single"); set("voltage",0);
set("force ohmic",1);
set("surface type","solid:simulation region");
set("solid","Si_Pp_right");
set("x min",0); set("x max",0);
set("y min",0); set("y max",1);
set("z min",0); set("z max",0);

addelectricalcontact; set("name","anode_back");
set("bc mode","steady state");
set("sweep type","single"); set("voltage",0);
set("force ohmic",1);
set("surface type","solid:simulation region");
set("solid","Si_Pp_back");
set("x min",0); set("x max",1);
set("y min",0); set("y max",0);
set("z min",0); set("z max",0);

mat_file = "ge_gen_oband.mat";

?"=== CHARGE dark current | T=300 K ===";
run;

res_dk = getresult("CHARGE","cathode");
V_dk   = res_dk.V_cathode;
I_dk   = res_dk.I;
In_dk  = res_dk.In;
Ip_dk  = res_dk.Ip;

diff_V = abs(V_dk-(-1)); idx1V = 1;
for(k=1; k<=length(V_dk); k=k+1) {
    if(diff_V(k) < diff_V(idx1V)) { idx1V = k; }
}
Id_1V = abs(I_dk(idx1V));
?"Dark current @ -1 V: "+num2str(Id_1V*1e9,"%.3f")+" nA   (paper: 1.3 nA)";

if (fileexists(mat_file)) {
    switchtolayout;

    addimportgen;
    set("name","optical_gen");
    select("CHARGE::optical_gen");
    importdataset(mat_file);
    set("enabled",1);

    run;

    res_ill = getresult("CHARGE","cathode");
    V_ill   = res_ill.V_cathode;
    I_ill   = res_ill.I;
    In_ill  = res_ill.In;
    Ip_ill  = res_ill.Ip;

    diff_V = abs(V_ill-(-1)); idx1V = 1;
    for(k=1; k<=length(V_ill); k=k+1) {
        if(diff_V(k) < diff_V(idx1V)) { idx1V = k; }
    }

    I_ph   = abs(I_ill(idx1V)) - Id_1V;
    R_AW   = I_ph / P_opt;
    A_eff  = Ge_L * Ge_W;
    D_star = R_AW * sqrt(A_eff) / sqrt(2*q_e*Id_1V) * 1e2;

    ?"Photo current  : "+num2str(I_ph*1e6,"%.3f")+" uA";
    ?"Responsivity   : "+num2str(R_AW,"%.3f")+" A/W   (paper: 0.95 A/W)";
    ?"D*             : "+num2str(D_star,"%.3e")+" cm Hz^0.5 W^-1   (paper: 2.95e10)";

    res_band  = getresult("CHARGE","bandstructure");
    res_carr  = getresult("CHARGE","charge");
    res_recmb = getresult("CHARGE","recombination");
    res_field = getresult("CHARGE","electrostatics");
    res_dope  = getresult("CHARGE","doping");
    res_mob   = getresult("CHARGE","mobility");

    z_phys  = res_band.z;  x_phys  = res_band.x;
    z_carr  = res_carr.z;  x_carr  = res_carr.x;
    z_recmb = res_recmb.z; x_Ropt  = res_recmb.x; z_Ropt = res_recmb.z;
    z_field = res_field.z; x_field = res_field.x;
    z_dope  = res_dope.z;  x_dope  = res_dope.x;
    z_mob   = res_mob.z;   x_mob   = res_mob.x;

    Ec_bulk  = res_band.Ec;   Ev_bulk  = res_band.Ev;
    Efn_bulk = res_band.Efn;  Efp_bulk = res_band.Efp; Ei_bulk = res_band.Ei;
    n_bulk   = res_carr.n;    p_bulk   = res_carr.p;
    Jn_bulk  = res_carr.Jn;   Jp_bulk  = res_carr.Jp;
    Ropt_bulk = res_recmb.Ropt; Rsrh_bulk = res_recmb.Rsrh;
    E_bulk   = res_field.E;   Vpot_bulk = res_field.V;
    NA_bulk  = res_dope.NA;   ND_bulk   = res_dope.ND;
    mun_bulk = res_mob.mun;   mup_bulk  = res_mob.mup;

    matlabsave("ge_charge_results_oband.mat",
               V_dk,  I_dk,  In_dk,  Ip_dk,
               V_ill, I_ill, In_ill, Ip_ill,
               Id_1V, I_ph, R_AW, A_eff, P_opt, Ge_L, Ge_W, idx1V,
               z_phys,  x_phys, z_carr,  x_carr,
               z_recmb, x_Ropt, z_Ropt, z_field, x_field,
               z_dope,  x_dope, z_mob,   x_mob,
               Ec_bulk,  Ev_bulk,  Efn_bulk, Efp_bulk, Ei_bulk,
               n_bulk,   p_bulk,   Jn_bulk,  Jp_bulk,
               Ropt_bulk, Rsrh_bulk, E_bulk,   Vpot_bulk,
               NA_bulk,  ND_bulk,  mun_bulk, mup_bulk);

} else {
    ?"WARNING: "+mat_file+" not found â€” run ge_pd_fdtd_oband.lsf first.";
}
?"=== CHARGE done â€” run ge_pd_oband_postprocess.m in MATLAB next ===";
