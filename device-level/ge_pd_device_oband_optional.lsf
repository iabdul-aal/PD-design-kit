
wg_H      = 220e-9;
z_rib_top = wg_H;
iGe_H_nom = 350e-9;
Npp_H     = 50e-9;
Ge_L      = 8e-6;
Ge_W      = 5e-6;
Pp_ext    = 1e-6;
T_sim     = 300;

function find_V_idx(V_arr, V_target) {
    d    = abs(V_arr - V_target);
    best = 1;
    for (k = 1; k <= length(V_arr); k = k+1) {
        if (d(k) < d(best)) { best = k; }
    }
    return best;
}

?"--- i-Ge thickness sweep ---";

iGe_arr = [200, 250, 300, 350, 400] * 1e-9;
nI      = length(iGe_arr);
Id_iGe  = matrix(1, nI);

for (iI = 1; iI <= nI; iI = iI+1) {
    zt = z_rib_top + iGe_arr(iI);
    zn = zt + Npp_H;

    switchtolayout;
    select("i_Ge");             set("z max", zt);
    select("Npp_Ge");           set("z min", zt);   set("z max", zn);
    select("dope_Npp");         set("z min", zt);   set("z max", zn);
    select("dope_iGe");         set("z min", z_rib_top); set("z max", zt);
    select("SiO2_clad_left");   set("z max", zn);
    select("SiO2_clad_right");  set("z max", zn);

    run;

    res    = getresult("CHARGE","cathode");
    i1     = find_V_idx(res.V_cathode, 1);
    Id_iGe(iI) = abs(res.I(i1));

    ?"  i-Ge="+num2str(iGe_arr(iI)*1e9,"%.0f")+" nm  Id@-1V="+num2str(Id_iGe(iI)*1e9,"%.4f")+" nA";
}

zt_nom = z_rib_top + iGe_H_nom;
zn_nom = zt_nom + Npp_H;
switchtolayout;
select("i_Ge");            set("z max", zt_nom);
select("Npp_Ge");          set("z min", zt_nom);  set("z max", zn_nom);
select("dope_Npp");        set("z min", zt_nom);  set("z max", zn_nom);
select("dope_iGe");        set("z min", z_rib_top); set("z max", zt_nom);
select("SiO2_clad_left");  set("z max", zn_nom);
select("SiO2_clad_right"); set("z max", zn_nom);

?"--- Temperature sweep (Arrhenius) ---";

T_arr = [250, 273, 300, 325, 350, 375, 400];
nT    = length(T_arr);
Id_T  = matrix(1, nT);
invT  = matrix(1, nT);
logId = matrix(1, nT);

for (iT = 1; iT <= nT; iT = iT+1) {
    switchtolayout;
    select("CHARGE"); set("simulation temperature", T_arr(iT));
    run;

    res       = getresult("CHARGE","cathode");
    i1        = find_V_idx(res.V_cathode, 1);
    Id_T(iT)  = abs(res.I(i1));
    invT(iT)  = 1.0 / T_arr(iT);
    logId(iT) = log10(max(Id_T(iT)*1e9, 1e-30));

    ?"  T="+num2str(T_arr(iT))+" K  Id@-1V="+num2str(Id_T(iT)*1e9,"%.4f")+" nA";
}

switchtolayout;
select("CHARGE"); set("simulation temperature", T_sim);

?"--- U-shaped vs Parallel electrode ---";

switchtolayout;
run;
res_U  = getresult("CHARGE","cathode");
V_u    = res_U.V_cathode;
I_u    = abs(res_U.I);
Id_U   = I_u(find_V_idx(V_u, 1));

switchtolayout;
select("anode_back"); delete;
run;
res_P  = getresult("CHARGE","cathode");
V_p    = res_P.V_cathode;
I_p    = abs(res_P.I);
Id_P   = I_p(find_V_idx(V_p, 1));

?"  U-shaped  Id@-1V="+num2str(Id_U*1e9,"%.4f")+" nA";
?"  Parallel  Id@-1V="+num2str(Id_P*1e9,"%.4f")+" nA";

switchtolayout;
addelectricalcontact; set("name","anode_back");
set("bc mode","steady state");
set("sweep type","single"); set("voltage",0);
set("force ohmic",1);
set("surface type","solid"); set("solid","Si_Pp_back");

matlabsave("ge_charge_optional_oband.mat",
           iGe_arr, Id_iGe,
           T_arr, Id_T, invT, logId,
           V_u, I_u, Id_U,
           V_p, I_p, Id_P);

?"Saved ge_charge_optional_oband.mat";
?"Next: run ge_pd_oband_optional_postprocess.m in MATLAB.";
