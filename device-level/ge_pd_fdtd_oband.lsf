# Ge-on-Si Photodiode – FDTD Optical Simulation (O-band)
# Ref: Yang Shi et al., Photonics Research Vol.12 No.1, 2024
# Solver: Lumerical FDTD Solutions 2020 R2+

switchtolayout;
newproject;

# 1. CONSTANTS
c_light  = 3e8;
h_planck = 6.626e-34;
q_e      = 1.602e-19;

lambda_c   = 1.31e-6;
lambda_min = 1.26e-6;
lambda_max = 1.36e-6;
f_c = c_light / lambda_c;

mat_Si   = "Si (Silicon) - Palik";
mat_Ge   = "Ge (Germanium) - Palik";
mat_SiO2 = "SiO2 (Glass) - Palik";

# 2. GEOMETRY CONSTANTS
wg_W    = 500e-9;
wg_H    = 220e-9;
slab_H  = 90e-9;
Ge_W    = 5e-6;
iGe_H   = 350e-9;
Npp_H   = 50e-9;
Ge_H    = iGe_H + Npp_H;
taper_L = 40e-6;
BOX_H   = 2e-6;
sub_H   = 1e-6;
Ge_L_max = 8e-6;

z_sub_bot  = -(BOX_H + sub_H);
z_BOX_bot  = -BOX_H;
z_Si_bot   = 0;
z_slab_top = slab_H;
z_rib_top  = wg_H;
z_iGe_bot  = z_rib_top;
z_iGe_top  = z_rib_top + iGe_H;
z_Npp_top  = z_rib_top + Ge_H;

# 3. STATIC GEOMETRY
addrect; set("name","Si_substrate");
set("material", mat_Si);
set("x min",-taper_L-1e-6); set("x max", Ge_L_max+3e-6);
set("y span", Ge_W+6e-6);
set("z min", z_sub_bot); set("z max", z_BOX_bot);
set("override mesh order from material database",1); set("mesh order",3);

addrect; set("name","BOX");
set("material", mat_SiO2);
set("x min",-taper_L-1e-6); set("x max", Ge_L_max+3e-6);
set("y span", Ge_W+6e-6);
set("z min", z_BOX_bot); set("z max", z_Si_bot);
set("override mesh order from material database",1); set("mesh order",3);

addrect; set("name","Si_slab");
set("material", mat_Si);
set("x min",-taper_L-1e-6); set("x max", Ge_L_max+3e-6);
set("y span", Ge_W+6e-6);
set("z min", z_Si_bot); set("z max", z_slab_top);
set("override mesh order from material database",1); set("mesh order",3);

addrect; set("name","Si_ridge");
set("material", mat_Si);
set("x min",-taper_L-1e-6); set("x max", 0);
set("y min",-wg_W/2); set("y max", wg_W/2);
set("z min", z_slab_top); set("z max", z_rib_top);
set("override mesh order from material database",1); set("mesh order",2);

addpoly; set("name","Si_taper");
set("material", mat_Si);
V = [-taper_L, -wg_W/2;
     -taper_L,  wg_W/2;
      0,        Ge_W/2;
      0,       -Ge_W/2];
set("vertices",V);
set("z min", z_slab_top); set("z max", z_rib_top);
set("override mesh order from material database",1); set("mesh order",2);

addrect; set("name","i_Ge");
set("material", mat_Ge);
set("x min",0); set("x max", Ge_L_max);
set("y min",-Ge_W/2); set("y max", Ge_W/2);
set("z min", z_iGe_bot); set("z max", z_iGe_top);
set("override mesh order from material database",1); set("mesh order",2);

addrect; set("name","Npp_Ge");
set("material", mat_Ge);
set("x min",0); set("x max", Ge_L_max);
set("y min",-Ge_W/2); set("y max", Ge_W/2);
set("z min", z_iGe_top); set("z max", z_Npp_top);
set("override mesh order from material database",1); set("mesh order",2);

addrect; set("name","SiO2_clad");
set("material", mat_SiO2);
set("x min",-taper_L-1e-6); set("x max", Ge_L_max+3e-6);
set("y span", Ge_W+6e-6);
set("z min", z_Si_bot); set("z max", z_Npp_top+1e-6);
set("override mesh order from material database",1); set("mesh order",4);

# 4. FDTD REGION
addfdtd;
set("dimension","3D");
set("background material", mat_SiO2);
set("x min",-(taper_L+1e-6)); set("x max", Ge_L_max+2e-6);
set("y min", 0);               set("y max", Ge_W/2+2e-6);
set("z min", z_BOX_bot-0.5e-6); set("z max", z_Npp_top+1e-6);
set("simulation time", 2000e-15);
set("mesh accuracy", 3);
set("x min bc","PML"); set("x max bc","PML");
set("y min bc","Symmetric");
set("y max bc","PML");
set("z min bc","PML"); set("z max bc","PML");

# 5. MESH OVERRIDE
addmesh; set("name","mesh_Ge");
set("x min",-0.2e-6);    set("x max", Ge_L_max+0.2e-6);
set("y min", 0);          set("y max", Ge_W/2+0.1e-6);
set("z min", z_iGe_bot-0.1e-6); set("z max", z_Npp_top+0.1e-6);
set("dx",20e-9); set("dy",20e-9); set("dz",20e-9);

# 6. MONITORS
addpower; set("name","T_after_Ge");
set("monitor type",5);
set("output power",1);
set("frequency points",100);
set("x", Ge_L_max+0.5e-6);
set("y min",0); set("y max", Ge_W/2+1e-6);
set("z min", z_iGe_bot-0.3e-6); set("z max", z_Npp_top+0.5e-6);

addpower; set("name","R_input");
set("monitor type",5);
set("output power",1);
set("frequency points",100);
set("x",-(taper_L-2e-6));
set("y min",0); set("y max", wg_W/2+0.5e-6);
set("z min", z_Si_bot-0.3e-6); set("z max", z_rib_top+0.3e-6);

addpower; set("name","T_taper_in");
set("monitor type",5);
set("output power",1);
set("frequency points",100);
set("x",-(taper_L-1.5e-6));
set("y min",0); set("y max", wg_W/2+0.5e-6);
set("z min", z_Si_bot-0.2e-6); set("z max", z_rib_top+0.2e-6);

addpower; set("name","T_taper_out");
set("monitor type",5);
set("output power",1);
set("frequency points",100);
set("x",-0.5e-6);
set("y min",0); set("y max", Ge_W/2+0.5e-6);
set("z min", z_Si_bot-0.2e-6); set("z max", z_rib_top+0.2e-6);

addpower; set("name","Ge_absorption_3D");
set("monitor type",8);
set("output power",1);
set("override global monitor settings",1);
set("use wavelength spacing",1);
set("wavelength center", lambda_c); set("wavelength span",0);
set("x min",0); set("x max", Ge_L_max);
set("y min",0); set("y max", Ge_W/2);
set("z min", z_iGe_bot); set("z max", z_Npp_top);

addpower; set("name","E_xz_plane");
set("monitor type",6);
set("output power",0);
set("y",0);
set("x min",-taper_L); set("x max", Ge_L_max+1e-6);
set("z min", z_BOX_bot-0.2e-6); set("z max", z_Npp_top+0.5e-6);

# 7. MODE SOURCE
addmode; set("name","source");
set("injection axis","x"); set("direction","forward");
set("x",-(taper_L-1e-6));
set("y",0); set("y span", wg_W+1e-6);
set("z",(z_Si_bot+z_rib_top)/2); set("z span", wg_H+0.8e-6);
set("wavelength start", lambda_min); set("wavelength stop", lambda_max);
set("mode selection","fundamental TE mode");

?"";
?"=== FDTD O-band Ge PD ===";
?"Wavelength: "+num2str(lambda_min*1e9)+" - "+num2str(lambda_max*1e9)+" nm";
?"Ge width  : "+num2str(Ge_W*1e6)+" um   i-Ge: "+num2str(iGe_H*1e9)+" nm";
?"";

# SECTION A - Ge_L PARAMETRIC SWEEP
?"--- SECTION A: Ge_L parametric sweep ---";

Ge_L_arr = [2, 3, 4, 5, 6, 8] * 1e-6;
nL       = length(Ge_L_arr);
A_TE_arr = matrix(1, nL);

for (iL = 1; iL <= nL; iL = iL+1) {

    Ge_L = Ge_L_arr(iL);
    ?"  Ge_L = "+num2str(Ge_L*1e6,"%.0f")+" um ...";

    switchtolayout;
    select("i_Ge");            set("x max", Ge_L);
    select("Npp_Ge");          set("x max", Ge_L);
    select("Ge_absorption_3D");set("x max", Ge_L);
    select("T_after_Ge");      set("x",  Ge_L+0.5e-6);
    select("mesh_Ge");         set("x max", Ge_L+0.2e-6);

    run;

    f_arr   = getdata("T_after_Ge","f");
    T_vs_f  = transmission("T_after_Ge");
    R_vs_f  = transmission("R_input");

    T_c = real(interp(T_vs_f, f_arr, f_c));
    R_c = real(interp(R_vs_f, f_arr, f_c));
    A_TE_arr(iL) = max(1 - abs(T_c) - abs(R_c), 0);

    ?"    Absorption = "+num2str(A_TE_arr(iL)*100,"%.2f")+" %";
}

# Find minimum Ge_L for >95% absorption (no break - use flag)
Ge_L_optimal = Ge_L_arr(nL);
found_opt = 0;
for (iL = 1; iL <= nL; iL = iL+1) {
    if ( (A_TE_arr(iL) >= 0.95) & (found_opt == 0) ) {
        Ge_L_optimal = Ge_L_arr(iL);
        found_opt = 1;
    }
}

?"";
?"=== Section A Results ===";
?"Ge_L (um) | Absorption @ 1310 nm (%)";
?"----------+---------------------------";
for (iL = 1; iL <= nL; iL = iL+1) {
    flag = "";
    if (Ge_L_arr(iL) == Ge_L_optimal) { flag = "  <- optimal (>95%)"; }
    ?" "+num2str(Ge_L_arr(iL)*1e6,"%.0f")+"          "
       +num2str(A_TE_arr(iL)*100,"%.2f")+flag;
}
?"Optimal Ge_L : "+num2str(Ge_L_optimal*1e6,"%.0f")+" um";

plot(Ge_L_arr*1e6, A_TE_arr*100,
     "Ge length (um)","Absorption @ 1310 nm (%)","Section A - Absorption vs Ge_L");

# SECTION B - TE vs TM POLARISATION SENSITIVITY
?"";
?"--- SECTION B: TE vs TM polarisation ---";
?"  Ge_L = "+num2str(Ge_L_optimal*1e6,"%.0f")+" um (from Section A)";

A_pol = matrix(1,2);

# TE run
switchtolayout;
select("i_Ge");             set("x max", Ge_L_optimal);
select("Npp_Ge");           set("x max", Ge_L_optimal);
select("Ge_absorption_3D"); set("x max", Ge_L_optimal);
select("T_after_Ge");       set("x",  Ge_L_optimal+0.5e-6);
select("mesh_Ge");          set("x max", Ge_L_optimal+0.2e-6);
select("source");           set("mode selection", "fundamental TE mode");
?"  Running fundamental TE mode ...";
run;

f_arr  = getdata("T_after_Ge","f");
T_vs_f = transmission("T_after_Ge");
R_vs_f = transmission("R_input");
T_c = real(interp(T_vs_f, f_arr, f_c));
R_c = real(interp(R_vs_f, f_arr, f_c));
A_pol(1) = max(1 - abs(T_c) - abs(R_c), 0);
?"    Absorption = "+num2str(A_pol(1)*100,"%.2f")+" %";

# TM run
switchtolayout;
select("source"); set("mode selection", "fundamental TM mode");
?"  Running fundamental TM mode ...";
run;

f_arr  = getdata("T_after_Ge","f");
T_vs_f = transmission("T_after_Ge");
R_vs_f = transmission("R_input");
T_c = real(interp(T_vs_f, f_arr, f_c));
R_c = real(interp(R_vs_f, f_arr, f_c));
A_pol(2) = max(1 - abs(T_c) - abs(R_c), 0);
?"    Absorption = "+num2str(A_pol(2)*100,"%.2f")+" %";

PDL_dB = 10*log10(max(A_pol(1),1e-10) / max(A_pol(2),1e-10));

?"";
?"=== Section B Results @ "+num2str(Ge_L_optimal*1e6,"%.0f")+" um ===";
?"TE absorption : "+num2str(A_pol(1)*100,"%.2f")+" %";
?"TM absorption : "+num2str(A_pol(2)*100,"%.2f")+" %";
?"PDL (TE/TM)   : "+num2str(PDL_dB,"%.2f")+" dB";

# Reset source to TE
switchtolayout;
select("source"); set("mode selection","fundamental TE mode");

# SECTION C - TAPER COUPLING EFFICIENCY
?"";
?"--- SECTION C: Taper coupling efficiency ---";

switchtolayout;
select("i_Ge");             set("x max", Ge_L_optimal);
select("Npp_Ge");           set("x max", Ge_L_optimal);
select("Ge_absorption_3D"); set("x max", Ge_L_optimal);
select("T_after_Ge");       set("x", Ge_L_optimal+0.5e-6);
select("mesh_Ge");          set("x max", Ge_L_optimal+0.2e-6);

run;

f_arr      = getdata("T_taper_in","f");
T_in_vs_f  = transmission("T_taper_in");
T_out_vs_f = transmission("T_taper_out");

T_in_c  = real(interp(T_in_vs_f,  f_arr, f_c));
T_out_c = real(interp(T_out_vs_f, f_arr, f_c));

taper_eff     = T_out_c / max(T_in_c, 1e-10);
taper_loss_dB = -10*log10(max(taper_eff, 1e-10));

lambda_arr_nm = c_light / f_arr * 1e9;
taper_eff_vs_lam = T_out_vs_f / max(T_in_vs_f, 1e-10);

?"";
?"=== Section C Results ===";
?"T_taper_in  @ 1310 nm : "+num2str(T_in_c*100,"%.2f")+" %";
?"T_taper_out @ 1310 nm : "+num2str(T_out_c*100,"%.2f")+" %";
?"Taper efficiency       : "+num2str(taper_eff*100,"%.2f")+" %";
?"Taper insertion loss   : "+num2str(taper_loss_dB,"%.3f")+" dB";

plot(lambda_arr_nm, taper_eff_vs_lam*100,
     "Wavelength (nm)","Taper Efficiency (%)","Section C - Si Taper O-band Coupling");

# SECTION D - EXPORT GENERATION RATE
?"";
?"--- SECTION D: Export generation rate ---";

# Extract Pabs from solver (no hardcoded optical constants)
Pabs_result = getresult("Ge_absorption_3D", "Pabs");
x_g   = Pabs_result.x;
y_g   = Pabs_result.y;
z_g   = Pabs_result.z;
Pabs  = pinch(Pabs_result.Pabs);

# Compute optical generation rate: G = Pabs / (photon energy)
# f_c already defined from simulation wavelength at top of script
G_3d = Pabs / (h_planck * f_c);

?"  G grid: "+num2str(length(x_g))+"x"+num2str(length(y_g))+"x"+num2str(length(z_g));
?"  x range: ["+num2str(min(x_g)*1e6,"%.3f")+", "+num2str(max(x_g)*1e6,"%.3f")+"] um";
?"  y range: ["+num2str(min(y_g)*1e6,"%.3f")+", "+num2str(max(y_g)*1e6,"%.3f")+"] um";
?"  z range: ["+num2str(min(z_g)*1e9,"%.1f")+", "+num2str(max(z_g)*1e9,"%.1f")+"] nm";
?"  Peak G  = "+num2str(max(G_3d),"%.3e")+" m-3 s-1";

matlabsave("ge_gen_oband.mat", x_g, y_g, z_g, G_3d);

# Save summary scalars — names must match ge_pd_oband_postprocess.m
Ge_L_opt  = Ge_L_optimal;
A_TE      = A_pol(1);
matlabsave("fdtd_summary_oband.mat", Ge_L_opt, Ge_W, iGe_H, lambda_c, A_TE, taper_eff, PDL_dB);

?"Saved: ge_gen_oband.mat         <- arrays: x_g, y_g, z_g, G_3d";
?"Saved: fdtd_summary_oband.mat   <- scalars: Ge_L_opt, Ge_W, iGe_H, lambda_c, A_TE, taper_eff, PDL_dB";
?"";
?"=== FDTD complete ===";
?"Next step: open ge_pd_device_oband.lsf in DEVICE and run.";
