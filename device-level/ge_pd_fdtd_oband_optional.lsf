
c0         = 3e8;
h_planck   = 6.626e-34;
q_e        = 1.602e-19;
lambda_c   = 1.31e-6;
lambda_min = 1.26e-6;
lambda_max = 1.36e-6;
f_c        = c0 / lambda_c;
iGe_H      = 350e-9;
Npp_H      = 50e-9;
slab_H     = 90e-9;
wg_H       = 220e-9;
wg_W       = 500e-9;
Ge_W       = 5e-6;
z_Si_bot   = 0;
z_slab_top = slab_H;
z_rib_top  = wg_H;
z_iGe_bot  = z_rib_top;
z_iGe_top  = z_rib_top + iGe_H;
z_Npp_top  = z_rib_top + iGe_H + Npp_H;
taper_L    = 40e-6;

?"--- Ge_L sweep ---";

Ge_L_arr = [2, 3, 4, 5, 6, 8] * 1e-6;
nL       = length(Ge_L_arr);
A_arr    = matrix(1, nL);

Ge_L_optimal = Ge_L_arr(nL);
found_opt    = 0;

for (iL = 1; iL <= nL; iL = iL+1) {
    Ge_L = Ge_L_arr(iL);
    switchtolayout;
    select("i_Ge");             set("x max", Ge_L);
    select("Npp_Ge");           set("x max", Ge_L);
    select("Ge_absorption_3D"); set("x max", Ge_L);
    select("T_after_Ge");       set("x",  Ge_L+0.5e-6);
    select("mesh_Ge");          set("x max", Ge_L+0.2e-6);
    run;
    f_arr_s   = getdata("T_after_Ge","f");
    T_c       = real(interp(transmission("T_after_Ge"), f_arr_s, f_c));
    R_c       = real(interp(transmission("R_input"),    f_arr_s, f_c));
    A_arr(iL) = max(1 - abs(T_c) - abs(R_c), 0);
    if ((A_arr(iL) >= 0.95) & (found_opt == 0)) {
        Ge_L_optimal = Ge_L_arr(iL);
        found_opt    = 1;
    }
    ?"  Ge_L="+num2str(Ge_L*1e6,"%.0f")+" um  A="+num2str(A_arr(iL)*100,"%.2f")+"%";
}
?"Ge_L_optimal = "+num2str(Ge_L_optimal*1e6,"%.0f")+" um";

switchtolayout;
select("i_Ge");             set("x max", 8e-6);
select("Npp_Ge");           set("x max", 8e-6);
select("Ge_absorption_3D"); set("x max", 8e-6);
select("T_after_Ge");       set("x", 8.5e-6);
select("mesh_Ge");          set("x max", 8.2e-6);

?"--- TE/TM polarisation ---";

pol   = {"fundamental TE mode","fundamental TM mode"};
A_pol = matrix(1,2);

for (ip = 1; ip <= 2; ip = ip+1) {
    switchtolayout;
    select("source"); set("mode selection", pol{ip});
    run;
    f_arr_s   = getdata("T_after_Ge","f");
    T_c       = real(interp(transmission("T_after_Ge"), f_arr_s, f_c));
    R_c       = real(interp(transmission("R_input"),    f_arr_s, f_c));
    A_pol(ip) = max(1 - abs(T_c) - abs(R_c), 0);
    ?"  "+pol{ip}+"  A="+num2str(A_pol(ip)*100,"%.2f")+"%";
}
PDL_dB = 10*log10(max(A_pol(1),1e-10) / max(A_pol(2),1e-10));
?"  PDL = "+num2str(PDL_dB,"%.3f")+" dB";

switchtolayout;
select("source"); set("mode selection","fundamental TE mode");

?"--- Taper insertion loss ---";

switchtolayout;
addpower; set("name","T_in");
set("monitor type",5);
set("output power",1);
set("override global monitor settings",1); set("frequency points",100);
set("x",-(taper_L-1.5e-6));
set("y min",0); set("y max", wg_W/2+0.5e-6);
set("z min",z_Si_bot-0.2e-6); set("z max",z_rib_top+0.2e-6);

addpower; set("name","T_out");
set("monitor type",5);
set("output power",1);
set("override global monitor settings",1); set("frequency points",100);
set("x",-0.5e-6);
set("y min",0); set("y max", Ge_W/2+0.5e-6);
set("z min",z_Si_bot-0.2e-6); set("z max",z_rib_top+0.2e-6);

run;

f_arr_s = getdata("T_in","f");
T_in    = real(interp(transmission("T_in"),  f_arr_s, f_c));
T_out   = real(interp(transmission("T_out"), f_arr_s, f_c));
IL_dB   = -10*log10(max(T_out/max(T_in,1e-10), 1e-10));
?"  Taper IL @ 1310 nm: "+num2str(IL_dB,"%.3f")+" dB";

switchtolayout;
select("T_in");  delete;
select("T_out"); delete;

?"--- Spectral responsivity ---";

lambda_sweep = [1260,1270,1280,1290,1300,1310,1320,1330,1340,1350,1360]*1e-9;
nS   = length(lambda_sweep);
A_sp = matrix(1,nS);
R_sp = matrix(1,nS);

for (iS = 1; iS <= nS; iS = iS+1) {
    lc = lambda_sweep(iS);
    fc = c0 / lc;
    switchtolayout;
    select("source");
    set("wavelength start",lc-25e-9); set("wavelength stop",lc+25e-9);
    select("Ge_absorption_3D");
    set("wavelength center",lc); set("wavelength span",20e-9);
    run;
    f_arr_s  = getdata("T_after_Ge","f");
    Tc       = real(interp(transmission("T_after_Ge"), f_arr_s, fc));
    Rc       = real(interp(transmission("R_input"),    f_arr_s, fc));
    A_sp(iS) = max(1 - abs(Tc) - abs(Rc), 0);
    R_sp(iS) = A_sp(iS) * q_e * lc / (h_planck * c0);
    ?"  "+num2str(lc*1e9,"%.0f")+" nm  A="+num2str(A_sp(iS)*100,"%.2f")+"%  R="+num2str(R_sp(iS),"%.3f")+" A/W";
}

switchtolayout;
select("source");
set("wavelength start",lambda_min); set("wavelength stop",lambda_max);
select("Ge_absorption_3D");
set("wavelength center",lambda_c); set("wavelength span",0);

matlabsave("ge_fdtd_optional_oband.mat",
           Ge_L_arr, A_arr,
           A_pol, PDL_dB, IL_dB,
           lambda_sweep, A_sp, R_sp);
?"Saved ge_fdtd_optional_oband.mat";
