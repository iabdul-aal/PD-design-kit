# ============================================================
# 01_build.lsf  — Build geometry, set up solver, save .ldev
# Run FIRST. All other scripts depend on the .ldev this saves.
# ============================================================

script_dir  = filedirectory(which(currentscriptname));
device_dir  = script_dir + "/../..";
project_dir = device_dir + "/projects";
repo_root   = device_dir + "/../..";
res_dir     = repo_root + "/results/device/main/";
gen_file    = repo_root + "/results/fdtd/main/ge_pd_gen_oband_ushaped.mat";

P_opt     = 100e-6;
Ge_W      = 5e-6;
Ge_L      = 8e-6;
wg_H      = 220e-9;
slab_H    = 90e-9;
iGe_H     = 350e-9;   # kept at 350 nm to match already-run FDTD/gen file
                      # TODO: update to 400e-9 after re-running FDTD
                      #       (paper: 400 nm Ge deposited, 50 nm N++ top => 350 nm i-Ge)
Npp_H     = 50e-9;
BOX_H     = 2e-6;
sub_H     = 0.5e-6;
Al_ind_H  = 300e-9;
D1        = 1.6e-6;
D2        = 2.56e-6;

ext_W          = Ge_W * 1.1;
iGe_W_bot      = Ge_W;
iGe_W_top      = Ge_W * 0.5;
Npp_W          = iGe_W_top;
Al_cath_W_bot  = Npp_W * 0.6;
Al_cath_W_top  = Npp_W * 0.8;
Al_anode_W_bot = 200e-9;
Al_anode_W_top = 500e-9;
clad_margin    = 2e-6;

z_sub_bot  = -(BOX_H + sub_H);
z_BOX_bot  = -BOX_H;
z_Si_bot   = 0;
z_slab_top = slab_H;
z_ext_top  = wg_H;
z_iGe_bot  = z_ext_top;
z_iGe_top  = z_iGe_bot + iGe_H;
z_Npp_bot  = z_iGe_top - Npp_H;
z_Npp_top  = z_iGe_top;
z_cath_bot = z_Npp_bot;
z_cath_top = z_Npp_top + 200e-9;
z_ind_bot  = z_cath_top;
z_Al_top   = z_ind_bot + Al_ind_H;

y_anode_in_bot  = Ge_W/2 + D1;
y_anode_out_bot = y_anode_in_bot + Al_anode_W_bot;
y_anode_in_top  = Ge_W/2 + D1;
y_anode_out_top = y_anode_in_top + Al_anode_W_top;
y_left          = -(y_anode_out_bot + clad_margin);
y_right         =  (y_anode_out_bot + clad_margin);

x_mid          = Ge_L / 2;
x_back_min_bot = Ge_L + D2;
x_back_max_bot = x_back_min_bot + Al_anode_W_bot;
x_back_min_top = Ge_L + D2;
x_back_max_top = x_back_min_top + Al_anode_W_top;
x_cath_max     = Ge_L;
x_cath_center  = Ge_L / 2;

# Voltage sweep: -4.0 V to +1.0 V, 26 points (200 mV step)
V_num      = 26;
V_start    = -4.0;
V_stop     =  1.0;
# SSAC bias points (reverse bias only)
V_ssac_arr = [-0.5, -1, -1.5, -2, -2.5];
nV_ssac    = length(V_ssac_arr);

mat_Si   = "silicon";
mat_Ge   = "germanium";
mat_SiO2 = "sio2";
mat_Al   = "aluminum";

switchtolayout;
deleteall;

addmodelmaterial;
set("name", mat_Si);
set("color", [0.6; 0.6; 0.9; 1]);
addmaterialproperties("CT", "Si (Silicon)");
select("::model::materials::silicon::Si (Silicon)");
set("recombination.trap assisted.taun.constant", 1e-6);
set("recombination.trap assisted.taup.constant", 1e-6);
select("materials::silicon");
addmaterialproperties("HT", "Si (Silicon)");

addmodelmaterial;
set("name", mat_Ge);
set("color", [0.4; 0.8; 0.4; 1]);
addmaterialproperties("CT", "Ge (Germanium)");
select("::model::materials::germanium::Ge (Germanium)");
set("recombination.trap assisted.taun.constant", 10e-9);
set("recombination.trap assisted.taup.constant", 10e-9);
select("materials::germanium");
addmaterialproperties("HT", "Ge (Germanium)");

addmodelmaterial;
set("name", mat_SiO2);
set("color", [0.8; 0.9; 1.0; 1]);
addmaterialproperties("CT", "SiO2 (Glass) - Sze");
select("materials::sio2");
addmaterialproperties("HT", "SiO2 (Glass) - Sze");

addmodelmaterial;
set("name", mat_Al);
set("color", [0.85; 0.85; 0.1; 1]);
addmaterialproperties("CT", "Al (Aluminium) - CRC");
select("materials::aluminum");
addmaterialproperties("HT", "Al (Aluminium) - CRC");

addrect;
set("name", "SiO2_clad");
set("material", mat_SiO2);
set("x min", -clad_margin);            set("x max", x_back_max_top + clad_margin);
set("y min", y_left - clad_margin);    set("y max", y_right + clad_margin);
set("z min", z_sub_bot - clad_margin); set("z max", z_Al_top + clad_margin);
set("alpha", 0.3);

addrect;
set("name", "Si_substrate");
set("material", mat_Si);
set("x min", -clad_margin);         set("x max", x_back_max_top + clad_margin);
set("y min", y_left - clad_margin); set("y max", y_right + clad_margin);
set("z min", z_sub_bot);            set("z max", z_BOX_bot);

addrect;
set("name", "BOX");
set("material", mat_SiO2);
set("x min", -clad_margin);         set("x max", x_back_max_top + clad_margin);
set("y min", y_left - clad_margin); set("y max", y_right + clad_margin);
set("z min", z_BOX_bot);            set("z max", z_Si_bot);

addstructuregroup;
set("name", "Si_ppp_group");
adduserprop("clad_margin",    2, clad_margin);
adduserprop("x_back_max_top", 2, x_back_max_top);
adduserprop("y_left",         2, y_left);
adduserprop("y_right",        2, y_right);
adduserprop("z_Si_bot",       2, z_Si_bot);
adduserprop("z_slab_top",     2, z_slab_top);
adduserprop("z_ext_top",      2, z_ext_top);
adduserprop("Ge_L",           2, Ge_L);
adduserprop("ext_W",          2, ext_W);
adduserprop("mat_Si",         5, mat_Si);
set("script", "
addrect;
set('name', 'Si_slab');
set('material', mat_Si);
set('x min', -clad_margin);         set('x max', x_back_max_top + clad_margin);
set('y min', y_left - clad_margin); set('y max', y_right + clad_margin);
set('z min', z_Si_bot);             set('z max', z_slab_top);

addrect;
set('name', 'Si_ext');
set('material', mat_Si);
set('x min', 0);          set('x max', Ge_L);
set('y min', -ext_W/2);   set('y max', ext_W/2);
set('z min', z_slab_top); set('z max', z_ext_top);
");

addpyramid;
set("name", "iGe");
set("material", mat_Ge);
set("x", x_mid); set("y", 0);
set("x span bottom", Ge_L); set("x span top", Ge_L);
set("y span bottom", iGe_W_bot); set("y span top", iGe_W_top);
set("z min", z_iGe_bot); set("z max", z_iGe_top);

addrect;
set("name", "Npp_Ge");
set("material", mat_Ge);
set("x min", 0); set("x max", Ge_L);
set("y min", -Npp_W/2); set("y max", Npp_W/2);
set("z min", z_Npp_bot); set("z max", z_Npp_top);

addstructuregroup;
set("name", "Al_cath_group");
adduserprop("x_cath_center",  2, x_cath_center);
adduserprop("x_cath_max",     2, x_cath_max);
adduserprop("Al_cath_W_bot",  2, Al_cath_W_bot);
adduserprop("Al_cath_W_top",  2, Al_cath_W_top);
adduserprop("z_cath_bot",     2, z_cath_bot);
adduserprop("z_ind_bot",      2, z_ind_bot);
adduserprop("z_Al_top",       2, z_Al_top);
adduserprop("mat_Al",         5, mat_Al);
set("script", "
addpyramid;
set('name', 'Al_cath_taper');
set('material', mat_Al);
set('x', x_cath_center); set('y', 0);
set('x span bottom', x_cath_max); set('x span top', x_cath_max);
set('y span bottom', Al_cath_W_bot); set('y span top', Al_cath_W_top);
set('z min', z_cath_bot); set('z max', z_ind_bot);

addrect;
set('name', 'Al_cath_ind');
set('material', mat_Al);
set('x min', 0); set('x max', x_cath_max);
set('y min', -Al_cath_W_top/2); set('y max', Al_cath_W_top/2);
set('z min', z_ind_bot); set('z max', z_Al_top);
");

addstructuregroup;
set("name", "Al_anode_group");
adduserprop("x_back_min_bot",  2, x_back_min_bot);
adduserprop("x_back_max_bot",  2, x_back_max_bot);
adduserprop("x_back_min_top",  2, x_back_min_top);
adduserprop("x_back_max_top",  2, x_back_max_top);
adduserprop("y_anode_in_bot",  2, y_anode_in_bot);
adduserprop("y_anode_out_bot", 2, y_anode_out_bot);
adduserprop("y_anode_in_top",  2, y_anode_in_top);
adduserprop("y_anode_out_top", 2, y_anode_out_top);
adduserprop("z_Si_bot",        2, z_Si_bot);
adduserprop("z_ind_bot",       2, z_ind_bot);
adduserprop("z_Al_top",        2, z_Al_top);
adduserprop("mat_Al",          5, mat_Al);
set("script", "
addrect;
set('name', 'Al_anode_left_taper');
set('material', mat_Al);
set('x min', 0); set('x max', x_back_min_bot);
set('y min', -y_anode_out_bot); set('y max', -y_anode_in_bot);
set('z min', z_Si_bot); set('z max', z_ind_bot);

addrect;
set('name', 'Al_anode_right_taper');
set('material', mat_Al);
set('x min', 0); set('x max', x_back_min_bot);
set('y min', y_anode_in_bot); set('y max', y_anode_out_bot);
set('z min', z_Si_bot); set('z max', z_ind_bot);

addrect;
set('name', 'Al_anode_back_taper');
set('material', mat_Al);
set('x min', x_back_min_bot); set('x max', x_back_max_bot);
set('y min', -y_anode_out_bot); set('y max', y_anode_out_bot);
set('z min', z_Si_bot); set('z max', z_ind_bot);

addrect;
set('name', 'Al_anode_left_ind');
set('material', mat_Al);
set('x min', 0); set('x max', x_back_min_top);
set('y min', -y_anode_out_top); set('y max', -y_anode_in_top);
set('z min', z_ind_bot); set('z max', z_Al_top);

addrect;
set('name', 'Al_anode_right_ind');
set('material', mat_Al);
set('x min', 0); set('x max', x_back_min_top);
set('y min', y_anode_in_top); set('y max', y_anode_out_top);
set('z min', z_ind_bot); set('z max', z_Al_top);

addrect;
set('name', 'Al_anode_back_ind');
set('material', mat_Al);
set('x min', x_back_min_top); set('x max', x_back_max_top);
set('y min', -y_anode_out_top); set('y max', y_anode_out_top);
set('z min', z_ind_bot); set('z max', z_Al_top);
");


select("simulation region");
set("dimension", "2D X-Normal");
set("x", x_mid);
set("y", 0);
set("y span", y_right - y_left + 2*clad_margin);
set("z min", z_Si_bot);
set("z max", z_Al_top);

addchargesolver;
set("name", "CHARGE");
set("solver mode", "steady state");
set("simulation temperature", 300);
set("norm length", Ge_L);
set("global iteration limit", 150);
set("solver type", "newton");

adddope;
set("name", "Ppp_slab");
set("dopant type", "p");
set("concentration", 1e26);
set("volume type", "solid"); set("volume solid", "Si_ppp_group::Si_slab");
set("x min", -clad_margin); set("x max",  x_back_max_top + clad_margin);
set("y min",  y_left  - clad_margin); set("y max",  y_right + clad_margin);
set("z min",  z_Si_bot); set("z max",  z_slab_top);

adddope;
set("name", "Ppp_ext");
set("dopant type", "p");
set("concentration", 1e26);
set("volume type", "solid"); set("volume solid", "Si_ppp_group::Si_ext");
set("x min", -clad_margin); set("x max",  x_back_max_top + clad_margin);
set("y min",  y_left  - clad_margin); set("y max",  y_right + clad_margin);
set("z min",  z_slab_top); set("z max",  z_ext_top);

adddope;
set("name", "iGe_background");
set("dopant type", "p");
set("concentration", 1e20);
set("volume type", "solid"); set("volume solid", "iGe");
set("x min", 0); set("x max", Ge_L);
set("y min", -iGe_W_bot/2); set("y max",  iGe_W_bot/2);
set("z min",  z_iGe_bot); set("z max",  z_Npp_bot);

adddope;
set("name", "Npp_contact");
set("dopant type", "n");
set("concentration", 1e26);
set("volume type", "solid"); set("volume solid", "Npp_Ge");
set("x min", 0); set("x max", Ge_L);
set("y min", -Npp_W/2); set("y max",  Npp_W/2);
set("z min",  z_Npp_bot); set("z max",  z_Npp_top);

addchargemesh;
set("name", "mesh_Ge");
set("x min", 0); set("x max", Ge_L);
set("y min", -Ge_W/2 - 100e-9); set("y max", Ge_W/2 + 100e-9);
set("z min", z_iGe_bot); set("z max", z_Npp_top);
set("max edge length", 15e-9);

addchargemesh;
set("name", "mesh_Si");
set("x min", 0); set("x max", x_back_max_top);
set("y min", y_left); set("y max", y_right);
set("z min", z_Si_bot); set("z max", z_slab_top);
set("max edge length", 50e-9);

addelectricalcontact;
set("name", "cathode");
set("bc mode", "steady state");
set("sweep type", "single");
set("voltage", 0);
set("force ohmic", 1);
set("surface type", "solid");
set("solid", "Al_cath_group");

addelectricalcontact;
set("name", "anode");
set("bc mode", "steady state");
set("sweep type", "range");
set("range start", V_start);
set("range stop",  V_stop);
set("range num points", V_num);
set("force ohmic", 1);
set("surface type", "solid");
set("solid", "Al_anode_group");

addsurfacerecombinationbc;
set("name", "srbc_Ge_SiO2");
set("surface type", "material:material");
set("material 1", mat_Ge); set("material 2", mat_SiO2);
set("electron velocity", 1e4); set("hole velocity", 1e4);

addsurfacerecombinationbc;
set("name", "srbc_Ge_Si");
set("surface type", "material:material");
set("material 1", mat_Ge); set("material 2", mat_Si);
set("electron velocity", 1e3); set("hole velocity", 1e3);

addsurfacerecombinationbc;
set("name", "srbc_Si_SiO2");
set("surface type", "material:material");
set("material 1", mat_Si); set("material 2", mat_SiO2);
set("electron velocity", 1e4); set("hole velocity", 1e4);

addsurfacerecombinationbc;
set("name", "srbc_Ge_Al");
set("surface type", "material:material");
set("material 1", mat_Ge); set("material 2", mat_Al);
set("electron velocity", 1e5); set("hole velocity", 1e5);

addsurfacerecombinationbc;
set("name", "srbc_Si_Al");
set("surface type", "material:material");
set("material 1", mat_Si); set("material 2", mat_Al);
set("electron velocity", 1e5); set("hole velocity", 1e5);

addbandstructuremonitor;
set("name", "monitor_band");
set("monitor type", 4);
set("x", x_mid); set("y", 0);
set("z", (z_Si_bot + z_iGe_top)/2);
set("z span", z_iGe_top - z_Si_bot + 200e-9);
set("record Evac", 1);

addimportgen;
set("name", "optical_gen");
set("enabled", 0);
set("scale factor", 1);  # G from FDTD already at P_opt — no extra scaling
#set("volume type", "solid"); set("volume solid", "iGe");
select("CHARGE::optical_gen");
importdataset(gen_file);

# Save .ldev — all parallel scripts load from this file
save(project_dir + "/ge_pd_charge_oband_ushaped.ldev");
?"Build complete. .ldev saved.";
