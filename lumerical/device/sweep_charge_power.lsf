script_dir  = filedirectory(which(currentscriptname));
device_dir  = script_dir + "/..";
project_dir = device_dir + "/projects";
repo_root   = device_dir + "/../..";
res_dir     = repo_root + "/results/device/power/";

P_opt_nom  = 100e-6;
scale_nom  = 1;
P_opt_arr  = [1, 5, 10, 50, 100, 500, 1000] * 1e-6;
scale_arr  = scale_nom * (P_opt_arr / P_opt_nom);
nP         = length(P_opt_arr);
V_bias_nom = -1;
V_start    = -2.5;
V_stop     =  0.0;
V_num      = 26;

load(project_dir + "/ge_pd_charge_power_base.ldev");
save(project_dir + "/ge_pd_charge_power_ushaped.ldev");

I_anode_p_matrix = matrix(1, nP);
I_cathode_p_matrix = matrix(1, nP);

for (iP = 1; iP <= nP; iP = iP + 1) {
    switchtolayout;
    select("CHARGE::optical_gen");
    set("enabled", 1);
    set("scale factor", scale_arr(iP));
    select("CHARGE::boundary conditions::cathode");
    set("bc mode", "steady state");
    set("sweep type", "single");
    set("voltage", 0);
    set("apply ac small signal", "none");
    select("CHARGE::boundary conditions::anode");
    set("bc mode", "steady state");
    set("sweep type", "single");
    set("voltage", V_bias_nom);
    set("apply ac small signal", "none");
    select("CHARGE");
    set("solver mode", "steady state");
    run;
    
    anode_res = getresult("CHARGE", "anode");
    I_anode_p_matrix(1, iP) = anode_res.I;
    cath_res = getresult("CHARGE", "cathode");
    I_cathode_p_matrix(1, iP) = cath_res.I;
}

power_ushaped_I_anode = matrixdataset("I_anode");
power_ushaped_I_anode.addparameter("V_anode", V_bias_nom);
power_ushaped_I_anode.addparameter("scale_factor", scale_arr);
power_ushaped_I_anode.addattribute("I", I_anode_p_matrix);

power_ushaped_I_cathode = matrixdataset("I_cathode");
power_ushaped_I_cathode.addparameter("V_anode", V_bias_nom);
power_ushaped_I_cathode.addparameter("scale_factor", scale_arr);
power_ushaped_I_cathode.addattribute("I", I_cathode_p_matrix);

matlabsave(res_dir + "ge_pd_charge_power_ushaped", power_ushaped_I_anode, power_ushaped_I_cathode, P_opt_arr, scale_arr);


I_anode_p_iv_matrix = matrix(V_num, nP);
I_cathode_p_iv_matrix = matrix(V_num, nP);

for (iP = 1; iP <= nP; iP = iP + 1) {
    switchtolayout;
    select("CHARGE::optical_gen");
    set("enabled", 1);
    set("scale factor", scale_arr(iP));
    select("CHARGE::boundary conditions::cathode");
    set("bc mode", "steady state");
    set("sweep type", "single");
    set("voltage", 0);
    set("apply ac small signal", "none");
    select("CHARGE::boundary conditions::anode");
    set("bc mode", "steady state");
    set("sweep type", "range");
    set("range start", 0.0);
    set("range stop",  -2.5);
    set("range num points", V_num);
    set("apply ac small signal", "none");
    select("CHARGE");
    set("solver mode", "steady state");
    run;
    
    anode_res = getresult("CHARGE", "anode");
    if (iP == 1) {
        V_arr_sweep = anode_res.V_anode;
    }
    I_anode_p_iv_matrix(1:V_num, iP) = anode_res.I;
    
    cathode_res = getresult("CHARGE", "cathode");
    I_cathode_p_iv_matrix(1:V_num, iP) = cathode_res.I;
}

V_sorted = matrix(V_num);
I_anode_p_iv_matrix_sorted = matrix(V_num, nP);
I_cathode_p_iv_matrix_sorted = matrix(V_num, nP);
for (iP = 1; iP <= nP; iP = iP + 1) {
    for (iV = 1; iV <= V_num; iV = iV + 1) {
        if (iP == 1) {
            V_sorted(iV) = V_arr_sweep(V_num - iV + 1);
        }
        I_anode_p_iv_matrix_sorted(iV, iP) = I_anode_p_iv_matrix(V_num - iV + 1, iP);
        I_cathode_p_iv_matrix_sorted(iV, iP) = I_cathode_p_iv_matrix(V_num - iV + 1, iP);
    }
}

power_ushaped_iv_I_anode = matrixdataset("I_anode");
power_ushaped_iv_I_anode.addparameter("V_anode", V_sorted);
power_ushaped_iv_I_anode.addparameter("scale_factor", scale_arr);
power_ushaped_iv_I_anode.addattribute("I", I_anode_p_iv_matrix_sorted);

power_ushaped_iv_I_cathode = matrixdataset("I_cathode");
power_ushaped_iv_I_cathode.addparameter("V_anode", V_sorted);
power_ushaped_iv_I_cathode.addparameter("scale_factor", scale_arr);
power_ushaped_iv_I_cathode.addattribute("I", I_cathode_p_iv_matrix_sorted);

matlabsave(res_dir + "ge_pd_charge_power_ushaped_iv", power_ushaped_iv_I_anode, power_ushaped_iv_I_cathode, P_opt_arr, scale_arr);
